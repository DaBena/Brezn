{
  "name": "brezn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "apply-patches": "patch-package",
    "check:deps": "node scripts/check-dependency-scripts.mjs",
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:locales": "node scripts/check-locale-keys.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:preview": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@scure/base": "^1.2.6",
    "@types/leaflet": "^1.9.22",
    "dexie": "^4.4.7",
    "i18next": "^26.4.5",
    "leaflet": "^1.9.4",
    "ngeohash": "^0.6.4",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
